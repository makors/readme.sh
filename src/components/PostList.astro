---
import NoBreakHyphens from "@/components/NoBreakHyphens.astro";
import { formatDate, type Post } from "@/lib/posts";
interface Props { posts: Post[] }
const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty">Nothing published yet. The first post is on its way.</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`}>
          <span class="post-title"><NoBreakHyphens text={post.data.title} /></span>
          <span class="post-desc">{post.data.description}</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </a>
      </li>
    ))}
  </ul>
)}
